    dialogueText: "\uC5B4\uC11C \uC624\uC138\uC694. \uC5B4\uB5A4 \uB9DB\uC744 \uC88B\uC544\uD558\uC2DC\uB098\uC694?"
  - speakerName: "\uAC15\uD0DC\uC218"
